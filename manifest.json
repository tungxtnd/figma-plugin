{
  "name": "Figma Design Engine MVP",
  "id": "figma-design-engine-mvp",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "editorType": ["figma"],
  "networkAccess": {
    "allowedDomains": [
      "https://drive.google.com",
      "https://res.cloudinary.com",
      "https://images.pexels.com",
      "https://pixabay.com",
      "https://images.unsplash.com",
      "https://loremflickr.com"
    ],
    "devAllowedDomains": [
      "http://localhost:3000",
      "http://localhost:5678"
    ],
    "reasoning": "This plugin fetches design tasks from the NestJS backend and n8n webhooks, downloads images, and uploads the generated design assets."
  }
}
