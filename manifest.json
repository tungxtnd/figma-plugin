{
  "name": "Capi Thiết kế",
  "id": "figma-design-engine-mvp",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "editorType": ["figma"],
  "documentAccess": "dynamic-page",
  "relaunchButtons": [
    { "command": "open", "name": "Mở Capi Thiết kế" }
  ],
  "networkAccess": {
    "allowedDomains": [
      "https://automation.ipactechnology.com",
      "https://staging.ipactechnology.com",
      "https://res.cloudinary.com",
      "https://drive.google.com",
      "https://drive.usercontent.google.com",
      "https://lh3.googleusercontent.com",
      "https://fonts.googleapis.com",
      "https://fonts.gstatic.com"
    ],
    "devAllowedDomains": [
      "http://localhost:3000",
      "http://localhost:3001"
    ],
    "reasoning": "Plugin nhận việc dựng slide từ máy chủ Capi, tải ảnh nền/logo/ảnh nội dung từ Cloudinary và Google Drive, gửi ảnh slide đã dựng lên máy chủ, và tải font giao diện từ Google Fonts."
  }
}
